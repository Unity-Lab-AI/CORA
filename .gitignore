# C.O.R.A - Cognitive Operations & Reasoning Assistant
# .gitignore - Prevent secret commits

# ============ SECRETS & CREDENTIALS ============
# API keys, tokens, credentials - NEVER COMMIT
*.key
*.pem
*.env
.env
.env.*
secrets.json
credentials.json
*_config.json
*.secret

# ============ PYTHON ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# ============ IDE & EDITOR ============
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ============ OS FILES ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============ LOGS & TEMP ============
logs/
*.log
*.tmp
*.temp
*.bak
*.backup

# ============ DATA & CACHE ============
data/*.json
!data/tasks.json.example
backups/
*.cache
.cache/

# ============ MODELS (large files) ============
models/
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# ============ VOSK MODELS ============
vosk-model*/

# ============ TEST & COVERAGE ============
.coverage
htmlcov/
.tox/
.nox/
.pytest_cache/
tests/__pycache__/

# ============ JUPYTER ============
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============ SPECIFIC TO CORA ============
# GitHub token storage (stored in user home, but just in case)
github_token.json
**/github_token.json
.cora/

# Sensitive config files
config/settings.json
config/personality.json

# User data
data/knowledge.json
data/tasks.json
data/chat_history.json

# Voice recordings (if any)
voice/recordings/
*.wav
*.mp3

# Screenshots and images (user data)
screenshots/
*.png
*.jpg
*.jpeg
!ui/assets/*.png
!docs/*.png
!docs/images/*.png

# ============ DOWNLOADED TOOLS ============
# The tools/ folder is ONLY for downloaded binaries (mpv, ffmpeg, etc)
# CORA source code tools are in cora_tools/
tools/

# Windows NUL-device artifact
nul

# ============ .claude WORKFLOW (from Unity-Public-Claude-Workflow-v1.0) ============
# Machine-local session state — written by .claude/hooks/*
# These are per-machine artifacts, never team-shared.
.claude/.session-state.md
.claude/.session-env.json
.claude/.last-session.md
.claude/.session-tidbits.md
.claude/.session-usage.jsonl
.claude/.usage-tracking-disabled
.claude/.yolo-mode
.claude/.persona-state
.claude/.setup-complete
.claude/.studio-inbox.jsonl
.claude/.studio-outbox.jsonl

# Per-developer Claude Code settings override.
# `settings.json` is team-shared (committed); `settings.local.json` is the
# personal overlay where each dev keeps their own permissions / env vars.
.claude/settings.local.json

# User-private setup data — secrets, identity, assets
.claude/.env
.claude/user.json
.claude/user-context/

# Migration / refactor working trackers — temp tooling, never team-shared.
# Pattern matches `TODO.skills-migration.tmp.md`-style scratch files at repo root.
/TODO.*.tmp.md
/*.tmp.md

# Node / build artifacts (harmless if unused)
node_modules/
