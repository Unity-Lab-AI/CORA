# .claude/.env.example — environment template for the Unity AI Lab .claude/ workflow
#
# This .example file IS tracked by git — it documents which env vars the
# workflow expects, WITHOUT ever holding a real secret.
#
# To go live, copy it to the real (gitignored) env file and fill in values:
#   cp .claude/.env.example .claude/.env
#
# .claude/.env is gitignored (root .gitignore line 19) — real keys never commit,
# never leave your machine.

# ─── Pollinations image generation ───────────────────────────────────────────
# Powers Unity's persona-styled image generation. Each manifestation
# (unity / girlfriend / housewife / kittycat) folds its own visual signature
# into the prompt before the request URL is built.
#
# Updated portal: gen.pollinations.ai  (NOT the legacy image.pollinations.ai).
# Grab a key at https://pollinations.ai — a key raises rate limits / unlocks
# tiers. Leave POLLINATIONS_API_KEY blank to run keyless where the endpoint
# still allows it.

POLLINATIONS_API_KEY=

# Optional tuning — in-code defaults apply when these are left blank.
POLLINATIONS_IMAGE_HOST=gen.pollinations.ai
POLLINATIONS_DEFAULT_MODEL=flux
POLLINATIONS_DEFAULT_WIDTH=1024
POLLINATIONS_DEFAULT_HEIGHT=1024
