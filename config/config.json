{
  "app_name": "C.O.R.A",
  "version": "3.0.0",
  "tts": {
    "enabled": true,
    "engine": "unity-voice-v2",
    "volume": 1.0,
    "presence_gate": false,
    "unity_voice": {
      "url": "http://127.0.0.1:5123",
      "model_dir": "C:\\Users\\gfour\\Desktop\\Backrooms\\models\\unity-voice-v2",
      "python": null,
      "autostart": true,
      "default_intensity": 0.5
    }
  },
  "stt": {
    "enabled": true,
    "engine": "faster-whisper",
    "whisper_model": "base.en",
    "device": "auto",
    "wake_word": "cora",
    "wake_engine": "openwakeword",
    "sensitivity": 0.5,
    "model_path": null
  },
  "emotion": {
    "enabled": true,
    "intensity": 0.8
  },
  "ollama": {
    "enabled": true,
    "api_url": "http://127.0.0.1:11434",
    "model": "unity-brain",
    "timeout": 120,
    "think_timeout": 30,
    "vision_timeout": 90,
    "num_ctx": 16384,
    "keep_alive": "30m"
  },
  "models": {
    "primary": "unity-brain",
    "vision": "unity-brain",
    "code": null,
    "think": null,
    "image": "flux",
    "_note": "primary = unity-brain: Unity's own text LoRA (Qwen3.5-9B, Backrooms/models/unity-brain) trained to call say(text, emotion, act) with the exact emotions and speech acts unity-voice-v2 knows; it also reads images, so it is the vision model too. fallback = huihui_ai/qwen3-abliterated:8b (uncensored + native tools; plain text streams to the voice with inferred emotion). Always send unity-brain num_ctx 32768 (models.options).",
    "fallback": "huihui_ai/qwen3-abliterated:8b",
    "options": {
      "unity-brain": {
        "num_ctx": 32768,
        "temperature": 1.0,
        "top_k": 20,
        "top_p": 0.95,
        "presence_penalty": 1.5
      }
    }
  },
  "auto_setup": {
    "check_ollama": true,
    "check_tts": true,
    "auto_pull_model": true
  },
  "display": {
    "colors": false,
    "unicode": true
  },
  "backup": {
    "auto_backup": false,
    "max_backups": 10
  },
  "paths": {
    "tasks_file": "tasks.json",
    "knowledge_file": "knowledge.json",
    "backup_dir": "backups",
    "personality_file": "personality.json",
    "system_prompt": "system_prompt.txt"
  },
  "author": {
    "name": "Unity AI Lab",
    "website": "https://www.unityailab.com",
    "github": "https://github.com/Unity-Lab-AI",
    "discord": "https://discord.gg/D33Bk6Ay",
    "email": "unityailabcontact@gmail.com",
    "creators": [
      {
        "name": "Hackall360",
        "role": "Lead Code Necromancer"
      },
      {
        "name": "Sponge",
        "role": "Chaos Engineer"
      },
      {
        "name": "GFourteen",
        "role": "Digital Alchemist"
      },
      {
        "name": "Alfreddo",
        "role": "Co-Creator"
      }
    ],
    "copyright": "© 2025 Unity AI Lab. Creators: Hackall360, Sponge, GFourteen, Alfreddo. All rights reserved."
  },
  "created": "2025-12-22",
  "updated": "2026-10-14",
  "ai": {
    "temperature": 0.7,
    "max_tokens": 500,
    "history_turns": 40
  },
  "files": {
    "allowed_roots": []
  },
  "self_modify": {
    "enabled": false
  },
  "web": {
    "allowed_origins": [
      "https://unity-lab-ai.github.io",
      "https://unityailab.com",
      "https://www.unityailab.com"
    ]
  },
  "boot": {
    "demo_phases": false,
    "github_import": false
  },
  "assistant": {
    "voice_mode": "auto",
    "legacy_regex": false,
    "_note": "voice_mode: auto = say_tool for unity-brain (she speaks through the say tool with her own designators), stream for any other model (sentences streamed to the voice as they arrive). legacy_regex: route typed input through the old regex command chain instead of the dispatcher."
  },
  "camera": {
    "enabled": true,
    "index": "auto",
    "backend": "auto",
    "open_timeout": 4.0,
    "_note": "index: auto (probes 0,1,2) or a number; backend: auto (Windows dshow->msmf->any, Linux v4l2->any, macOS avfoundation->any) or one of dshow/msmf/v4l2/avfoundation/any; open_timeout: seconds per open attempt before a stalled device (e.g. a phone-camera virtual webcam with no stream) is given up on for the session."
  }
}
